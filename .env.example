# Compose environment. Copy to .env and adjust.
# .env is gitignored.

# Comma-separated emails that are granted the admin role on register/login.
ADMIN_EMAILS=admin@example.com

# Theme generation (optional; without it the theme machine reports
# unavailability). Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional model override (comma-separated); otherwise discovered live.
OPENROUTER_MODELS=
