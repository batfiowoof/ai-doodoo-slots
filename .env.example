# Compose environment. Copy to .env and adjust.
# .env is gitignored.

# Theme generation (optional; without it the theme machine reports
# unavailability). Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional model override (comma-separated); otherwise discovered live.
OPENROUTER_MODELS=

# Keycloak (auto-imported realm, test users see README). Unset
# KEYCLOAK_ISSUER in the api environment for guest-only mode.
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin
